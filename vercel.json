{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/deezer/:match*",
      "destination": "https://api.deezer.com/:match*"
    },
    {
      "source": "/api/full-audio/search",
      "destination": "/api/full-audio/search"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
